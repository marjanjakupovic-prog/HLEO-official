# HLEO — environment configuration template
#
# Copy to .env and fill in ONLY the values you need:
#     cp .env.example .env
#
# Every secret is OPTIONAL. HLEO degrades gracefully when a credential is
# absent:
#   - LLM features (scientific search, synthesis, assistant, extraction)
#     return 503 without an LLM provider key;
#   - Reddit, UMLS, LOINC and SNOMED providers are skipped when unconfigured.
#
# DO NOT commit real keys, tokens or passwords in this file.

# ── Database ─────────────────────────────────────────────────────────────
# Local development default: SQLite (no external service required).
# The bootloader and health checks honour DATABASE_URL exactly as set here.
DATABASE_URL=sqlite:///./hleo.db

# PostgreSQL (used by docker-compose.yml). DATABASE_URL above takes
# precedence when set; the variables below are the fallback components read
# by core/database.py when DATABASE_URL is empty.
# POSTGRES_USER=hleo_admin
# POSTGRES_PASSWORD=change-me
# POSTGRES_DB=hleo_db
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# Equivalent PG* aliases (same purpose, read by core/database.py):
# PGUSER=
# PGPASSWORD=
# PGDATABASE=
# PGHOST=
# PGPORT=

# ── LLM provider (core/llm_provider.py) ──────────────────────────────────
# HLEO_LLM_PROVIDER: auto | openai | perplexity | local   (default: auto)
# auto resolves to: perplexity (if PERPLEXITY_API_KEY set) → openai → local.
# HLEO_LLM_PROVIDER=auto
# OPENAI_API_KEY=
# PERPLEXITY_API_KEY=
# OPENAI_BASE_URL=
# HLEO_LLM_MODEL=

# Perplexity model overrides (defaults: sonar-pro for gpt-4o-class calls,
# sonar for gpt-4o-mini-class calls).
# HLEO_PERPLEXITY_MODEL=sonar-pro
# HLEO_PERPLEXITY_MODEL_MINI=sonar
# HLEO_PERPLEXITY_MODEL_FINAL=sonar-pro
# HLEO_PERPLEXITY_TIMEOUT=180
# HLEO_PERPLEXITY_MIN_MAX_TOKENS=8000
# HLEO_PERPLEXITY_DISABLE_SEARCH=1
# HLEO_PERPLEXITY_FALLBACK=1
# HLEO_PERPLEXITY_OPS=

# Local OpenAI-compatible endpoint (used when HLEO_LLM_PROVIDER=local).
# HLEO_LOCAL_LLM_URL=
# HLEO_LOCAL_LLM_MODEL=local-model
# HLEO_LOCAL_LLM_API_KEY=sk-local
# HLEO_LOCAL_LLM_TIMEOUT=600
# HLEO_LOCAL_LLM_OPS=
# HLEO_LOCAL_LLM_FALLBACK=1

# Optional JSONL log of every LLM call (default /tmp/hleo_llm_calls.jsonl).
# HLEO_LLM_CALL_LOG=/tmp/hleo_llm_calls.jsonl

# ── Admin authentication (core/admin_auth.py) ────────────────────────────
# If either variable is unset, the /admin section is fully disabled.
# Generate the hash with:
#   python -c "import bcrypt,os; print(bcrypt.hashpw(os.environ['PWD_PLAIN'].encode(), bcrypt.gensalt()).decode())"
# HLEO_ADMIN_USERNAME=
# HLEO_ADMIN_PASSWORD_HASH=
# HLEO_ADMIN_TOKEN_TTL=28800

# ── Reddit (collectors/reddit.py, OAuth2) ────────────────────────────────
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=

# ── Vocabulary layer "Catena C" (core/vocab/, defaults ON) ───────────────
# HLEO_VOCAB_ENABLED=1
# HLEO_VOCAB_PROVIDERS=rxnorm,mesh,conceptnet,wikidata
# HLEO_VOCAB_CACHE_TTL=86400
# HLEO_VOCAB_CACHE_PATH=
# HLEO_VOCAB_CACHE_DISABLE=0

# UMLS (core/vocab/umls.py) — needs a license; skipped when unset.
# UMLS_API_KEY=
# HLEO_UMLS_API_KEY=

# LOINC (core/vocab/loinc.py) — skipped when credentials are unset.
# HLEO_LOINC_USERNAME=
# HLEO_LOINC_PASSWORD=

# SNOMED (core/vocab/snomed.py) — inactive interface stub until configured.
# HLEO_SNOMED_API_KEY=
# HLEO_SNOMED_API_URL=

# ── RWE (core/rwe/) ──────────────────────────────────────────────────────
# HLEO_RWE_INTENT_SCORING=0
# HLEO_OPENFDA_MAX_RESULTS=1000

# ── Temporary results store (core/temp_store.py) ─────────────────────────
# TEMP_RESULTS_TTL=3600
# TEMP_STORE_CLEANUP_INTERVAL=60
